{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio of Abu Md. Moniruzjaman \u2014 agricultural extension & digital tools, DAE Bangladesh",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-static.mjs && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/verify-no-secrets.mjs dist",
    "build:fast": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "sync": "node scripts/sync-repos.mjs && node scripts/sync-drive.mjs",
    "verify": "node scripts/verify-no-secrets.mjs dist",
    "sync:drive": "node scripts/sync-drive.mjs",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:render": "node scripts/render-smoke.mjs",
    "test": "npm run test:scripts && npm run test:render",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5"
  }
}
