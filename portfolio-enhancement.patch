+}
+
+function FolderCard({ c }: { c: (typeof library.collections)[number] }) {
+  const { t, lang } = useI18n();
+  const [shown, setShown] = useState(false);
+  const id = c.folderId!;
+  return (
+    <div className="flex flex-col rounded-2xl border border-forest-400 bg-white p-5">
+      <h2 className="font-serif text-xl font-black text-forest-900">{lang === "bn" ? c.titleBn : c.title}</h2>
+      <p className="mt-1 text-sm text-moss-600">{lang === "bn" ? c.descriptionBn : c.description}</p>
+      <div className="mt-4 flex flex-wrap gap-2">
+        <a
