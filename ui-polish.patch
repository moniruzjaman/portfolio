+  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+  for (let k = 0.97; k > 0.2; k -= 0.03) {
+    const c = toHex(r * k, g * k, b * k);
+    if (contrast(c, WHITE) >= BAND_MIN_CONTRAST) return c;
+  }
+  return INK;
+}
