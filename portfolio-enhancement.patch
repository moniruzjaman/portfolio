diff --git a/scripts/gen-static.mjs b/scripts/gen-static.mjs
new file mode 100644
index 0000000..340b807
--- /dev/null
+++ b/scripts/gen-static.mjs
@@ -0,0 +1,61 @@
+/**
+ * gen-static.mjs — writes the files that must agree with the deployment base path:
+ *   public/404.html   GitHub Pages deep-link shim (needs the base to match)
+ *   public/sitemap.xml, public/robots.txt   (need the absolute site URL)
+ *
+ * They used to be hand-written with "/portfolio/" and the site root baked in, which
+ * disagreed with each other. Deriving all three from BASE_PATH / SITE_ORIGIN — the
+ * same inputs vite.config.ts reads — removes that class of drift.
+ */
+import { readFileSync, readdirSync, writeFileSync } from "node:fs";
+
+const BASE = process.env.BASE_PATH || "/portfolio/";
+const ORIGIN = (process.env.SITE_ORIGIN || "https://moniruzjaman.github.io").replace(/\/$/, "");
+const SITE = `${ORIGIN}${BASE}`;
+
+const repos = JSON.parse(readFileSync("src/data/repos.generated.json", "utf8")).repos;
+const noteSlugs = readdirSync("src/content/notes")
+  .filter((f) => f.endsWith(".ts"))
+  .map((f) => readFileSync(`src/content/notes/${f}`, "utf8").match(/slug:\s*"([^"]+)"/)?.[1])
+  .filter(Boolean);
+
+const paths = [
+  "", "works", "library", "expertise", "notes", "about",
+  ...repos.map((r) => `works/${r.slug}`),
+  ...noteSlugs.map((s) => `notes/${s}`),
+];
+writeFileSync(
+  "public/sitemap.xml",
+  `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n` +
+    paths.map((p) => `  <url><loc>${SITE}${p}</loc></url>`).join("\n") +
+    `\n</urlset>\n`,
+);
+
+writeFileSync("public/robots.txt", `User-agent: *\nAllow: /\n\nSitemap: ${SITE}sitemap.xml\n`);
+
+writeFileSync(
+  "public/404.html",
+  `<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <title>Abu Md. Moniruzzaman</title>
+    <script>
+      /* GENERATED by scripts/gen-static.mjs — do not edit.
+       * GitHub Pages has no rewrites, so a cold load of a deep link would 404 before
+       * the SPA boots. Stash the path, bounce to the shell; src/main.tsx replays it. */
+      (function () {
+        var BASE = ${JSON.stringify(BASE)};
+        var p = window.location.pathname;
+        if (p.indexOf(BASE) === 0 && p !== BASE) {
+          try { sessionStorage.setItem("ph:redirect", p + window.location.search + window.location.hash); } catch (e) {}
+          window.location.replace(BASE + "index.html");
+        }
+      })();
+    </script>
+  </head>
+  <body></body>
+</html>
+`,
+);
+console.log(`static: base ${BASE} · ${paths.length} sitemap URLs · ${SITE}`);
diff --git a/scripts/lib/brand-probe.mjs b/scripts/lib/brand-probe.mjs
new file mode 100644
index 0000000..700a28c
--- /dev/null
+++ b/scripts/lib/brand-probe.mjs
@@ -0,0 +1,191 @@
+/**
+ * brand-probe.mjs — derive an app's real branding from the app itself.
+ *
+ * Every app in this portfolio is a PWA, so each one already publishes its own
+ * brand: a web manifest (theme_color, icons) and <head> metadata. Reading those
+ * means the portfolio shows the colour and icon the app actually ships with, and
+ * it stays correct when an app is rebranded — no hand-maintained brand table.
+ *
+ * Failure policy (deliberately the opposite of sync-repos.mjs): brand is
+ * cosmetic. If a probe fails, the site falls back to a deterministic monogram and
+ * palette colour (src/lib/brand.ts). That is a degraded card, not a lie, so it
+ * must never abort a sync.
+ *
+ * Two traps this guards against:
+ *   - Vercel deployment protection answers 401 with Vercel's *own* login page.
+ *     Reading that would brand an app with Vercel's logo. We require a 200 and a
+ *     final URL that is still on an allowed host.
+ *   - SPA hosts answer unknown paths with index.html or a 404 page. We only
+ *     accept a manifest that parses as JSON with an `icons` array.
+ */
+
+import { urlAllowed } from "./hosts.mjs";
+
+const UA = "krishiai-hub-sync (+https://github.com/moniruzjaman/portfolio)";
+const MAX_HTML = 600_000;
+
+/* ── tiny, dependency-free tag parsing ────────────────────────────────── */
+
+function attrs(tag) {
+  const out = {};
+  const re = /([a-zA-Z_:][-a-zA-Z0-9_:.]*)\s*(?:=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'>]+)))?/g;
+  let m;
+  while ((m = re.exec(tag.replace(/^<\w+/, "").replace(/\/?>$/, "")))) {
+    out[m[1].toLowerCase()] = (m[2] ?? m[3] ?? m[4] ?? "").trim();
+  }
+  return out;
+}
+
+function tags(html, name) {
+  const re = new RegExp(`<${name}\\b[^>]*>`, "gi");
+  return (html.match(re) || []).map(attrs);
+}
+
+export function normaliseHex(v) {
+  if (typeof v !== "string") return null;
+  const s = v.trim().toLowerCase();
+  const m = s.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/);
+  if (!m) return null;
+  const h = m[1];
+  return "#" + (h.length === 3 ? [...h].map((c) => c + c).join("") : h);
+}
+
+const resolve = (href, base, allow = urlAllowed) => {
+  if (!href) return null;
+  try {
+    const u = new URL(href, base);
+    return allow(u.href) ? u.href : null;
+  } catch {
+    return null;
+  }
+};
+
+const decode = (s) =>
+  s
+    .replace(/&amp;/g, "&")
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;|&apos;/g, "'")
+    .replace(/&lt;/g, "<")
+    .replace(/&gt;/g, ">")
+    .trim();
+
+/** Largest declared size from "48x48 96x96", or 0 for "any"/missing. */
+function maxSize(sizes) {
+  if (!sizes) return 0;
+  return Math.max(0, ...sizes.split(/\s+/).map((s) => Number(s.split("x")[0]) || 0));
+}
+
+/* ── <head> metadata ──────────────────────────────────────────────────── */
+
+export function parseHtml(html, baseUrl, allow = urlAllowed) {
+  const metas = tags(html, "meta");
+  const links = tags(html, "link");
+  const meta = (key) =>
+    metas.find((m) => (m.name || m.property || "").toLowerCase() === key)?.content;
+
+  const themeColor = metas
+    .filter((m) => (m.name || "").toLowerCase() === "theme-color")
+    .map((m) => normaliseHex(m.content))
+    .find(Boolean) ?? null;
+
+  const rels = (rel) => links.filter((l) => (l.rel || "").toLowerCase().split(/\s+/).includes(rel));
+
+  // Prefer a real raster/touch icon (crisp on a card) over the favicon.
+  const touch = rels("apple-touch-icon").sort((a, b) => maxSize(b.sizes) - maxSize(a.sizes))[0];
+  const icons = [...rels("icon"), ...rels("shortcut")]
+    .filter((l) => l.href)
+    .sort((a, b) => maxSize(b.sizes) - maxSize(a.sizes));
+  const svg = icons.find((l) => /svg/.test(l.type || "") || /\.svg(\?|$)/i.test(l.href));
+  const iconHref = (touch || svg || icons[0])?.href;
+
+  const titleTag = html.match(/<title[^>]*>([^<]*)<\/title>/i)?.[1];
+
+  return {
+    name: decode(meta("og:site_name") || meta("application-name") || titleTag || "") || null,
+    description: decode(meta("og:description") || meta("description") || "") || null,
+    themeColor,
+    icon: resolve(iconHref, baseUrl, allow),
+    image: resolve(meta("og:image"), baseUrl, allow),
+    manifest: resolve(rels("manifest")[0]?.href, baseUrl, allow),
+  };
+}
+
+/* ── web app manifest ─────────────────────────────────────────────────── */
+
+export function parseManifest(json, manifestUrl, allow = urlAllowed) {
+  if (!json || typeof json !== "object" || !Array.isArray(json.icons)) return null;
+  const usable = json.icons
+    .filter((i) => i && typeof i.src === "string" && !/maskable/.test(i.purpose || ""))
+    .map((i) => ({ ...i, px: maxSize(i.sizes) }));
+  // Pick the smallest icon that is still >=192px (sharp, but not a 1MB asset);
+  // else the largest available.
+  const sharp = usable.filter((i) => i.px >= 192).sort((a, b) => a.px - b.px)[0];
+  const best = sharp || usable.sort((a, b) => b.px - a.px)[0];
+  return {
+    name: json.short_name || json.name || null,
+    themeColor: normaliseHex(json.theme_color),
+    backgroundColor: normaliseHex(json.background_color),
+    icon: resolve(best?.src, manifestUrl, allow),
+  };
+}
+
+/* ── fetch ────────────────────────────────────────────────────────────── */
+
+async function get(url, fetchImpl, accept) {
+  const ctrl = new AbortController();
+  const timer = setTimeout(() => ctrl.abort(), 8000);
+  try {
+    const res = await fetchImpl(url, {
+      redirect: "follow",
+      signal: ctrl.signal,
+      headers: { "User-Agent": UA, Accept: accept },
+    });
+    return res;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/**
+ * @param {string} url  a live deployment URL
+ * @param {{fetchImpl?: typeof fetch, allowUrl?: (u:string)=>boolean}} [opts]
+ * @returns {Promise<null | {name?:string, themeColor?:string, icon?:string, image?:string, source:"manifest"|"html"}>}
+ */
+export async function probeBrand(url, opts = {}) {
+  const fetchImpl = opts.fetchImpl || fetch;
+  const allow = opts.allowUrl || urlAllowed;
+  if (!url || !allow(url)) return null;
+
+  try {
+    const res = await get(url, fetchImpl, "text/html");
+    // 200 only: a 401 here is Vercel's login wall, not the app.
+    if (res.status !== 200) return null;
+    if (res.url && !allow(res.url)) return null; // bounced to an SSO/login host
+    const html = (await res.text()).slice(0, MAX_HTML);
+    const page = parseHtml(html, res.url || url, allow);
+
+    let man = null;
+    if (page.manifest) {
+      try {
+        const mres = await get(page.manifest, fetchImpl, "application/manifest+json,application/json");
+        if (mres.status === 200) man = parseManifest(await mres.json(), mres.url || page.manifest, allow);
+      } catch {
+        /* a broken manifest is not fatal — the <head> still has brand data */
+      }
+    }
+
+    const themeColor = man?.themeColor || page.themeColor || null;
+    const icon = man?.icon || page.icon || null;
+    const brand = {
+      name: man?.name || page.name || undefined,
+      themeColor: themeColor || undefined,
+      icon: icon || undefined,
+      image: page.image || undefined,
+      source: man ? "manifest" : "html",
+    };
+    if (!brand.themeColor && !brand.icon && !brand.image) return null;
+    return Object.fromEntries(Object.entries(brand).filter(([, v]) => v !== undefined));
+  } catch {
+    return null;
+  }
+}
diff --git a/scripts/lib/hosts.mjs b/scripts/lib/hosts.mjs
new file mode 100644
index 0000000..58e4150
--- /dev/null
+++ b/scripts/lib/hosts.mjs
@@ -0,0 +1,50 @@
+/**
+ * Single source of truth for which hosts the *shipped site* may reference.
+ *
+ * Imported by verify-no-secrets.mjs (the CI gate) and by the build-time probes
+ * (brand-probe.mjs). A brand icon, preview frame or deployment link whose host is
+ * not on this list is dropped at sync time instead of failing the build later.
+ */
+
+export const ALLOWED_HOSTS = [
+  // fonts
+  "fonts.googleapis.com",
+  "fonts.gstatic.com",
+  // source + published sites
+  "github.com",
+  "moniruzjaman.github.io",
+  "raw.githubusercontent.com",
+  "user-images.githubusercontent.com",
+  "camo.githubusercontent.com",
+  "avatars.githubusercontent.com",
+  "api.github.com",
+  // the four deployment channels this portfolio showcases
+  "krishiai.live",
+  "vercel.app",
+  "workers.dev",
+  "pages.dev",
+  "surge.sh",
+  // Google Drive library: link-out and click-to-load preview frames only
+  "drive.google.com",
+  "docs.google.com",
+];
+
+export const hostOf = (u) => {
+  try {
+    return new URL(u).hostname.toLowerCase();
+  } catch {
+    return null;
+  }
+};
+
+export const hostAllowed = (host) =>
+  Boolean(host) && ALLOWED_HOSTS.some((h) => host === h || host.endsWith(`.${h}`));
+
+export const urlAllowed = (u) => {
+  try {
+    const url = new URL(u);
+    return (url.protocol === "https:" || url.protocol === "http:") && hostAllowed(url.hostname.toLowerCase());
+  } catch {
+    return false;
+  }
+};
diff --git a/scripts/render-smoke.mjs b/scripts/render-smoke.mjs
new file mode 100644
index 0000000..811bed4
--- /dev/null
+++ b/scripts/render-smoke.mjs
@@ -0,0 +1,40 @@
+/**
+ * render-smoke.mjs — server-renders real routes through Vite and asserts on the output.
+ *
+ * Exists because the sub-path routing bug (every route, including "/", rendering
+ * Not Found under /portfolio/) passed the typecheck, the build AND the secrets
+ * gate. Only rendering the app at its real base path can catch that class of bug.
+ *
+ * Runs at both a sub-path and the root, since the deployment target may change.
+ */
+import { createServer } from "vite";
+
+const CASES = [
+  // [base, route, must contain, must NOT contain]
+  ["/portfolio/", "", "I build digital tools", "This page does not exist"],
+  ["/portfolio/", "works", "The live ecosystem", "This page does not exist"],
+  ["/portfolio/", "works/web-krishiai-live", "web.krishiai.live", "This page does not exist"],
+  ["/portfolio/", "library", "Research, documents and presentations", "This page does not exist"],
+  ["/portfolio/", "definitely-not-a-page", "This page does not exist", null],
+  ["/", "works", "The live ecosystem", "This page does not exist"],
+  ["/", "library", "Research, documents and presentations", "This page does not exist"],
+];
+
+let failed = 0;
+for (const base of [...new Set(CASES.map((c) => c[0]))]) {
+  process.env.BASE_PATH = base;
+  const vite = await createServer({ root: process.cwd(), server: { middlewareMode: true }, appType: "custom", logLevel: "error" });
+  const { renderAt } = await vite.ssrLoadModule("/src/test/ssr-probe.tsx");
+  for (const [b, route, want, unwanted] of CASES.filter((c) => c[0] === base)) {
+    const html = renderAt(b + route).replace(/<[^>]+>/g, " ").replace(/&amp;/g, "&");
+    const ok = html.includes(want) && (!unwanted || !html.includes(unwanted));
+    if (!ok) failed++;
+    console.log(`${ok ? "✔" : "✖"} base ${b.padEnd(11)} /${route.padEnd(26)} ${ok ? "" : `expected "${want}"`}`);
+  }
+  await vite.close();
+}
+if (failed) {
+  console.error(`\n✖ ${failed} render check(s) failed`);
+  process.exit(1);
+}
