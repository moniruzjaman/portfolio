+          src={folderEmbedUrl(id)}
+          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
+          className="mt-4 h-[420px] w-full rounded-xl border border-forest-300 bg-white"
+        />
+      )}
+    </div>
+  );
+}
